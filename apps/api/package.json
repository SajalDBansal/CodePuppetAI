{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "bun --env-file=../../packages/database/.env --env-file=.env --watch ./src/index.ts",
    "lint": "tsc --noEmit && eslint src --max-warnings 0",
    "start": "bun --env-file=../../packages/database/.env --env-file=.env ./src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/database": "*",
    "@workspace/protocol": "*",
    "@workspace/provider-registry": "*",
    "@workspace/tool-registry": "*",
    "better-auth": "^1.6.25",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "morgan": "^1.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.24",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.2",
    "globals": "^17.6.0",
    "typescript": "5.5.4"
  }
}